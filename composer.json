{
    "name": "reinfyteam/slapper-cooldown",
    "description": "PocketMine-MP plugin that adds a cooldown between Slapper hits.",
    "type": "project",
    "license": "LGPL-3.0-only",
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/axolotl-pm/PocketMine-MP",
            "no-api": true
        }
    ],
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "axolotl-pm/pocketmine-mp": "5.49.1"
    },
    "autoload": {
        "psr-4": {
            "ReinfyTeam\\SlapperCooldown\\": "src/"
        }
    },
    "scripts": {
        "analyse": "vendor/bin/phpstan analyse -c phpstan.neon.dist"
    }
}
